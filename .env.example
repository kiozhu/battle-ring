# ==================================
# Battle Ring — Konfigurasi
# ==================================
# Copy file ini ke .env dan isi nilainya
# cp .env.example .env

# Port server (default: 5051)
PORT=5051

# Username TikTok (tanpa @)
# Digunakan untuk auto-connect saat startup
TIKTOK_USERNAME=username_kamu

# EulerStream API Key (wajib untuk koneksi TikTok)
# Dapatkan gratis di: https://www.eulerstream.com/
EULER_API_KEY=kunci_api_kamu
